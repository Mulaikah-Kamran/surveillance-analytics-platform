# Virtual environments
.venv/
venv/
env/
ENV/

# Python cache / bytecode
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Ruff / linters
.ruff_cache/

# OS artifacts
.DS_Store
Thumbs.db

# IDE settings
.vscode/
.idea/

# Reproducible generated artifacts (not committed; regenerated by the pipeline)
outputs/
results/
*.log

# Raw research datasets — never committed (see README / docs on data
# acquisition). Small example/synthetic data used for demonstration is
# permitted and should be added explicitly with git add -f if ever
# placed under data/. The acquisition script itself is source code, not
# data, so it is explicitly un-ignored below.
data/*
!data/.gitkeep
!data/README.md
!data/download_national_extract.py
